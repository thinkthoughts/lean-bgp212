+theorem piece_pow {N : ℕ} (hN : 0 < N) (g L τ : ℝ) (C : ℕ → ℝ) (hC1 : g ≤ C 1)
+    (hCN : C N - N * g < 0) (R K : Finset (Fin N)) (m : ℕ) :
+    ∫ y in pieceSet N R (C R.card - R.card * g) (τ - (R.card + K.card) * g),
