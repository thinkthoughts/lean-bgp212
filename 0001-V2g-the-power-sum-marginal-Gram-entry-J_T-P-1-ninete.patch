+#!/usr/bin/env python3
+"""Emit Solution/PowerSumEntryCert.lean: the kernel certificate for J_T[P₂, 1] at Table 3.
+
+The closed form `p2EntryVal 44 g L τ C = p2Sum 44 … 2 + jtSum 44 … 4 0 / 3`
+(BGP212/PowerSumEntry.lean, BGP212/MarginalEntry.lean) is mirrored here in exact rational
+arithmetic (standard library only; the cell formulas are V2f's emitter). The 133 nonempty pieces
+(r ≤ 13, r + k ≤ 15) give one `decide +kernel` lemma each for `p2J` and for `pieceJ … 4 0`; every
+other piece vanishes by linear arithmetic; rows and totals are assembled by `decide +kernel` on
+numerals.
+
+Usage: python3 -I specs/checks/power_sum_entry_v2g_emit.py [output path] [--pieces r:k,...]
+"""
+import os
+import sys
+from fractions import Fraction as Fr
+from math import comb, factorial as fact
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import marginal_entry_v2f_emit as E  # noqa: E402
+
+N = 44
+
+
+def pieceE(r, k, eR, eS, m):
+    G, TAU, C = E.G, E.TAU, E.C
+    if C(r) - r * G < 0 or TAU - (r + k) * G < 0:
+        return Fr(0)
+    if r == 0:
+        return Fr(fact(eS), fact(N + eS - 1)) * E.seg0(k, TAU - k * G, N - 1 + eS, m, 0)
+    return (Fr(fact(eR), fact(r + eR - 1)) * Fr(fact(eS), fact(N - r + eS - 1))
+            * E.cells(r, k, C(r) - r * G, TAU - (r + k) * G, r - 1 + eR, N - r - 1 + eS, m, 0))
+
+
+def p2J(r, k, m=2):
+    G = E.G
+    return (k * (pieceE(r, k, 0, 2, m) + 2 * G * pieceE(r, k, 0, 1, m) + G ** 2 * pieceE(r, k, 0, 0, m))
+            + (N - r - k) * pieceE(r, k, 0, 2, m)
+            + r * (pieceE(r, k, 2, 0, m) + 2 * G * pieceE(r, k, 1, 0, m) + G ** 2 * pieceE(r, k, 0, 0, m)))
+
+
+def lit(x):
+    x = Fr(x)
+    return f"({x.numerator} : ℚ)" if x.denominator == 1 else f"({x.numerator} / {x.denominator} : ℚ)"
+
+
+HEADER = """/-
+Copyright (c) 2026 thinkthoughts. All rights reserved.
+Released under MIT license as described in the file LICENSE.
+Source: Axiom Math, "A New Bound for Small Gaps Between Primes", preliminary draft
+(September 3, 2026): Table 3 (p. 39), §9.4, Lemma 9.2 and the display of `J_T` (p. 41).
+-/
+import BGP212.PowerSumEntry
+
+/-! # V2g: the kernel certificate for `J_T[P₂, 1]` at Table 3
+
+COMPUTATIONAL CERTIFICATE (generated by `specs/checks/power_sum_entry_v2g_emit.py`). The closed form
+`p2EntryVal 44 g L τ C` (Table 3 data from `BGP212.Params`) is evaluated over `ℚ`:
+
+* the 133 nonempty pieces `(r, k)` (`r ≤ 13`, `r + k ≤ 15`) give one `decide +kernel` lemma each for
+  the `P₂` block `p2J` (`p2_r_k`) and for the `U⁴` block `pieceJ … 4 0` (`u4_r_k`);
+* every other piece vanishes by linear arithmetic (`p2J_tail`, `p2J_high`, `pieceJ4_tail`,
+  `pieceJ4_high`);
+* rows and totals are assembled by `decide +kernel` on the resulting numerals.
+
+The integral identity that gives this number its meaning, `p2Entry_eq`, is proved in
+`Solution/PowerSumEntry.lean`. -/
+
+namespace BGP212.V2e
+
+open BGP212.Params
+
+theorem cond_tail (r k : ℕ) (h : 16 ≤ r + k) : C r - r * g < 0 ∨ τ - (r + k) * g < 0 := by
+  right
+  have : (16 : ℚ) ≤ r + k := by exact_mod_cast h
+  rw [show τ = 249 / 250 from rfl, show g = 41 / 625 from rfl]
+  linarith
+
+theorem cond_high (r k : ℕ) (h : 14 ≤ r) : C r - r * g < 0 ∨ τ - (r + k) * g < 0 := by
+  left
+  have hr : (14 : ℚ) ≤ r := by exact_mod_cast h
+  have hC : C r = 4 * (1081 / 5000) := by
+    rw [C, B, if_neg (by omega), if_neg (by omega)]
+  rw [hC, show g = 41 / 625 from rfl]
+  linarith
+
+theorem pieceE_zero (r k eR eS m : ℕ) (h : C r - r * g < 0 ∨ τ - (r + k) * g < 0) :
+    pieceE 44 r k eR eS g L τ C m = 0 := by
+  unfold pieceE; rw [if_pos h]
+
+theorem p2J_zero (r k : ℕ) (h : C r - r * g < 0 ∨ τ - (r + k) * g < 0) :
+    p2J 44 r k g L τ C 2 = 0 := by
+  simp only [p2J, pieceE_zero r k _ _ _ h, mul_zero, add_zero]
+
+theorem pieceJ4_zero (r k : ℕ) (h : C r - r * g < 0 ∨ τ - (r + k) * g < 0) :
+    pieceJ 44 r k g L τ C 4 0 = 0 := by
+  unfold pieceJ; rw [if_pos h]
+
+theorem p2Row_high (r : ℕ) (h : 14 ≤ r) : p2Row 44 r g L τ C 2 = 0 :=
+  Finset.sum_eq_zero fun k _ => by rw [p2J_zero r k (cond_high r k h), mul_zero]
+
+theorem jtRow4_high (r : ℕ) (h : 14 ≤ r) : jtRow 44 r g L τ C 4 0 = 0 :=
+  Finset.sum_eq_zero fun k _ => by rw [pieceJ4_zero r k (cond_high r k h), mul_zero]
+
+theorem p2Sum_eq_rows (Nn : ℕ) {K : Type*} [Field K] [LinearOrder K] (g L τ : K) (C : ℕ → K) (m : ℕ) :
+    p2Sum Nn g L τ C m = (Nn + 1) * ∑ r ∈ Finset.range (Nn + 1), (Nn.choose r : K) * p2Row Nn r g L τ C m := rfl
+
+theorem jtSum_eq_rows' {K : Type*} [Field K] [LinearOrder K] (Nn : ℕ) (g L τ : K) (C : ℕ → K)
+    (m n : ℕ) : jtSum Nn g L τ C m n =
+      (Nn + 1) * ∑ r ∈ Finset.range (Nn + 1), (Nn.choose r : K) * jtRow Nn r g L τ C m n := rfl
+"""
+
+
+def main():
+    out = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("--") else "Solution/PowerSumEntryCert.lean"
+    only = None
+    if "--pieces" in sys.argv:
+        only = [tuple(int(v) for v in x.split(":")) for x in sys.argv[sys.argv.index("--pieces") + 1].split(",")]
+    lines = [HEADER]
+    p2v, u4v = {}, {}
+    for r in range(14):
+        for k in range(16 - r):
+            p2v[(r, k)] = p2J(r, k)
+            u4v[(r, k)] = E.pieceJ(r, k, 4, 0)
+    pieces = only if only else sorted(p2v)
+    for (r, k) in pieces:
+        lines.append(f"theorem p2_{r}_{k} : p2J 44 {r} {k} g L τ C 2 = {lit(p2v[(r, k)])} := by\n"
+                     "  decide +kernel\n")
+        lines.append(f"theorem u4_{r}_{k} : pieceJ 44 {r} {k} g L τ C 4 0 = {lit(u4v[(r, k)])} := by\n"
+                     "  decide +kernel\n")
+    if only is None:
+        p2row, u4row = {}, {}
+        for r in range(14):
+            K = 16 - r
+            tail = (N - r + 1) - K
+            p2row[r] = sum(comb(N - r, k) * (-1) ** k * p2v[(r, k)] for k in range(K))
+            u4row[r] = sum(comb(N - r, k) * (-1) ** k * u4v[(r, k)] for k in range(K))
+            for (nm, fn, val, lem, zero, args) in [
+                    ("p2Row", "p2Row 44 {r} g L τ C 2", p2row[r], "p2", "p2J_zero", "p2J 44 {r} ({K} + x) g L τ C 2"),
+                    ("jtRow4", "jtRow 44 {r} g L τ C 4 0", u4row[r], "u4", "pieceJ4_zero", "pieceJ 44 {r} ({K} + x) g L τ C 4 0")]:
+                names = ", ".join(f"{lem}_{r}_{k}" for k in range(K))
+                lines.append(
+                    f"theorem {nm}_{r} : {fn.format(r=r)} = {lit(val)} := by\n"
+                    f"  have hz : ∑ x ∈ Finset.range {tail}, (((44 - {r}).choose ({K} + x) : ℕ) : ℚ) *\n"
+                    f"      (-1) ^ ({K} + x) * {args.format(r=r, K=K)} = 0 :=\n"
+                    f"    Finset.sum_eq_zero fun x _ => by rw [{zero} {r} ({K} + x) (cond_tail {r} ({K} + x) (by omega)), mul_zero]\n"
+                    f"  rw [{'p2Row' if nm == 'p2Row' else 'jtRow'}, show 44 - {r} + 1 = {K} + {tail} from rfl, Finset.sum_range_add, hz, add_zero]\n"
+                    f"  simp only [Finset.sum_range_succ, Finset.sum_range_zero, {names}]\n"
+                    "  decide +kernel\n")
+        tot2 = (N + 1) * sum(comb(N, r) * p2row[r] for r in range(14))
+        tot4 = (N + 1) * sum(comb(N, r) * u4row[r] for r in range(14))
+        total = tot2 + tot4 / 3
+        for (nm, lhs, eq, rowfn, high, rown, tot) in [
+                ("p2Sum_table3", "p2Sum 44 g L τ C 2", "p2Sum_eq_rows", "p2Row 44 (14 + x) g L τ C 2", "p2Row_high", "p2Row", tot2),
+                ("jtSum4_table3", "jtSum 44 g L τ C 4 0", "jtSum_eq_rows'", "jtRow 44 (14 + x) g L τ C 4 0", "jtRow4_high", "jtRow4", tot4)]:
+            lines.append(
+                f"theorem {nm} : {lhs} = {lit(tot)} := by\n"
+                f"  have hz : ∑ x ∈ Finset.range 31, ((Nat.choose 44 (14 + x) : ℕ) : ℚ) *\n"
+                f"      {rowfn} = 0 :=\n"
+                f"    Finset.sum_eq_zero fun x _ => by rw [{high} (14 + x) (by omega), mul_zero]\n"
+                f"  rw [{eq}, show 44 + 1 = 14 + 31 from rfl, Finset.sum_range_add, hz, add_zero]\n"
+                "  simp only [Finset.sum_range_succ, Finset.sum_range_zero, "
+                + ", ".join(f"{rown}_{r}" for r in range(14)) + "]\n"
+                "  decide +kernel\n")
+        lines.append("/-- **`J_T[P₂, 1]` at Table 3** as a rational. -/\n"
+                     f"theorem p2EntryVal_table3 : p2EntryVal 44 g L τ C = {lit(total)} := by\n"
+                     "  rw [p2EntryVal, p2Sum_table3, jtSum4_table3]\n"
+                     "  decide +kernel\n")
+        print("J_T[P2,1] =", float(total))
+        print("value", total.numerator, "/", total.denominator)
+    lines.append("end BGP212.V2e\n")
+    open(out, "w").write("\n".join(lines))
+    print("wrote", out, "with", len(pieces), "pieces (2 lemmas each)")
+
+
+if __name__ == "__main__":
+    main()
