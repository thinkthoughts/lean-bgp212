import Solution.SymReadProfData
import Solution.SymTrieKept

/-! # V2o: coverage of the three-factor nodes of degree ≤ 26

COMPUTATIONAL DEMONSTRATION (generated by `specs/checks/sym_read_v2o_demo.py`). Tables are coefficient representations;
the rational moments `pieceMn` are evaluated separately. -/

namespace BGP212.V2e

open BGP212.Params

set_option maxRecDepth 20000


/-- **Coverage.** Every multiset of `B₂₁` with three factors and total degree `≤ 26` has a
profile certified by one direct transition (`To_prof_ok`). -/
theorem To_covers : ((shortMultisets 3).filter fun Q => Q.length = 3 ∧ Q.sum ≤ 26).all
    (fun Q => natListMem Q (To_prof.map Prod.fst)) = true := by
  rw [shortMultisets, b21Kept_eq]; decide +kernel

/-- The three-factor multisets of degree `≤ 26`: 66 of the 150 with three factors. -/
theorem three_counts : ((shortMultisets 3).filter fun Q => Q.length = 3).length = 150 ∧
    ((shortMultisets 3).filter fun Q => Q.length = 3 ∧ Q.sum ≤ 26).length = 66 := by
  rw [shortMultisets, b21Kept_eq]; decide +kernel

end BGP212.V2e
