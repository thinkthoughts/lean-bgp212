import Solution.SymProfileProfData

/-! # V2n: the block |λ| ≤ 8: shape and coverage

COMPUTATIONAL DEMONSTRATION (generated by `specs/checks/sym_profile_v2n_demo.py`). Tables are coefficient representations;
the rational moments `pieceMn` are evaluated separately. -/

namespace BGP212.V2e

open BGP212.Params

set_option maxRecDepth 20000


/-- The block `|λ| ≤ 8`: 52 factor multisets, sorted and prefix-closed. -/
theorem block8_shape : (blockMultisets 8).length = 52 ∧ trieShapeOK (blockMultisets 8) = true := by
  decide +kernel

/-- **Coverage.** Every multiset of the block `|λ| ≤ 8` has a certified moment profile at piece
`(6, 3)`, from V2m's staged certificates or V2n's direct transitions (`Tn_all_ok`). -/
theorem Tn_covers : (blockMultisets 8).all (fun Q => natListMem Q (Tn_all.map Prod.fst)) = true := by
  decide +kernel

end BGP212.V2e
