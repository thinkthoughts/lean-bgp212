import Solution.SymTrieKept
import Solution.SymTrieProfData

/-! # V2m: the certified subtree covers the enumerated multisets

COMPUTATIONAL DEMONSTRATION (generated by `specs/checks/sym_trie_v2m_demo.py`). Tables are coefficient representations;
the rational moments `pieceMn` are evaluated separately. -/

namespace BGP212.V2e

open BGP212.Params


/-- **Coverage.** Every multiset of the block `|λ| ≤ 6` and every multiset of `B₂₁` with at most
two factors has a certified moment profile at piece `(6, 3)` (`Tt_prof_ok`). -/
theorem Tt_covers : ((blockMultisets 6).all fun Q => natListMem Q (Tt_prof.map Prod.fst)) = true ∧
    ((shortMultisets 2).all fun Q => natListMem Q (Tt_prof.map Prod.fst)) = true := by
  rw [shortMultisets, b21Kept_eq]; decide +kernel

end BGP212.V2e
