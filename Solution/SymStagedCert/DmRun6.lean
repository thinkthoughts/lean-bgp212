/-! # V2ℓ: run `Dm`, factor 6: the merge of the chunks and the chain (generated by `specs/checks/sym_staged_v2l_demo.py`) -/

namespace BGP212.V2e


theorem Dm_s6 : StepCert demoN (fun c => lpShiftPow (clsShift (3 / 10 : ℚ) c) 2) Dm_L5 Dm_L6 :=
  stepCert_runs demoN (fun c => lpShiftPow (clsShift (3 / 10 : ℚ) c) 2) [Dm_L5_0, Dm_L5_1, Dm_L5_2, Dm_L5_3, Dm_L5_4, Dm_L5_5, Dm_L5_6, Dm_L5_7, Dm_L5_8, Dm_L5_9, Dm_L5_10, Dm_L5_11]
    [Dm_D6_0, Dm_D6_1, Dm_D6_2, Dm_D6_3, Dm_D6_4, Dm_D6_5, Dm_D6_6, Dm_D6_7, Dm_D6_8, Dm_D6_9, Dm_D6_10, Dm_D6_11] Dm_L6
    (List.Forall₂.cons Dm_s6_0 (List.Forall₂.cons Dm_s6_1 (List.Forall₂.cons Dm_s6_2 (List.Forall₂.cons Dm_s6_3 (List.Forall₂.cons Dm_s6_4 (List.Forall₂.cons Dm_s6_5 (List.Forall₂.cons Dm_s6_6 (List.Forall₂.cons Dm_s6_7 (List.Forall₂.cons Dm_s6_8 (List.Forall₂.cons Dm_s6_9 (List.Forall₂.cons Dm_s6_10 (List.Forall₂.cons Dm_s6_11 List.Forall₂.nil))))))))))))
    (by decide +kernel)

theorem Dm_c6 : ChainCert demoN (psFactors (3 / 10 : ℚ) [2, 2, 2, 2, 2, 2]) [([], 1)] Dm_L6 :=
  chainCert_snoc demoN (3 / 10 : ℚ) [2, 2, 2, 2, 2] 2 _ _ _ Dm_c5 Dm_s6

end BGP212.V2e
