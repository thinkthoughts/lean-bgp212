import Solution.SymStagedCert.DmRun1
import Solution.SymStagedCert.DmRun5D
import Solution.SymStagedCert.DmRun5C0
import Solution.SymStagedCert.DmRun5C1
import Solution.SymStagedCert.DmRun5C2
import Solution.SymStagedCert.DmRun5C3

/-! # V2ℓ: run `Dm`, factor 5: the merge of the chunks and the chain (generated by `specs/checks/sym_staged_v2l_demo.py`) -/

namespace BGP212.V2e


theorem Dm_s5 : StepCert demoN (fun c => lpShiftPow (clsShift (3 / 10 : ℚ) c) 2) Dm_L4 Dm_L5 :=
  stepCert_runs demoN (fun c => lpShiftPow (clsShift (3 / 10 : ℚ) c) 2) [Dm_L4_0, Dm_L4_1, Dm_L4_2, Dm_L4_3]
    [Dm_D5_0, Dm_D5_1, Dm_D5_2, Dm_D5_3] Dm_L5
    (List.Forall₂.cons Dm_s5_0 (List.Forall₂.cons Dm_s5_1 (List.Forall₂.cons Dm_s5_2 (List.Forall₂.cons Dm_s5_3 List.Forall₂.nil))))
    (by decide +kernel)

theorem Dm_c5 : ChainCert demoN (psFactors (3 / 10 : ℚ) [2, 2, 2, 2, 2]) [([], 1)] Dm_L5 :=
  chainCert_snoc demoN (3 / 10 : ℚ) [2, 2, 2, 2] 2 _ _ _ Dm_c4 Dm_s5

end BGP212.V2e
