  refine ⟨?_, ?_, ?_, trivial⟩ <;> decide +kernel

theorem sm_val3 : symFinal demoM sm_L3 = (21901244073952449 / 11626695080000 : ℚ) := by
  decide +kernel

theorem demo_place_222_staged : placeVal demoM demoN 0 Fin.elim0 Fin.elim0 (demoF [2, 2, 2]) =
    (21901244073952449 / 11626695080000 : ℚ) :=
  (placeVal_of_steps demoN (demoF [2, 2, 2]) _ sm_steps demoM).trans sm_val3

/-- The same statement as V2k's `demo_place_222`. -/
theorem demo_place_222_staged_same : demo_place_222_staged = demo_place_222 := rfl

/-- Prefix reuse: the chain of `P̂₂²` is the first two steps of the chain of `P̂₂³`. -/
theorem sm_chain2 : ChainCert demoN (demoF [2, 2]) [([], 1)] sm_L2 :=
  chainCert_of_steps demoN (demoF [2, 2]) _ [sm_L1, sm_L2] ⟨sm_steps.1, sm_steps.2.1, trivial⟩

