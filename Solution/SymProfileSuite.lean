theorem markProfile_step {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (φ : Fin 3 → List K) (T : ℕ) (L : List (SKey × K))
    (F : MarkKey → K) :
    ((markProfile T (symStepAll n φ L)).map fun e => e.2 * F e.1).sum =
      ((markStep n φ T (markProfile (T + 1) L)).map fun e => e.2 * F e.1).sum := by
  apply BGP212.V2e.markProfile_step <;> assumption

theorem markOK_of_chain {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (T : ℕ) (L : List (SKey × K))
    (P : List (MarkKey × K)) (h : ChainCert n (psFactors g Q) [([], 1)] L) (hP : markProfile T L = P) :
    MarkOK n g Q T P := by
  apply BGP212.V2e.markOK_of_chain <;> assumption

theorem markOK_of_chunks {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (T : ℕ) (Ls : List (List (SKey × K)))
    (Ps : List (List (MarkKey × K))) (P : List (MarkKey × K))
    (h : ChainCert n (psFactors g Q) [([], 1)] Ls.flatten)
    (hc : List.Forall₂ (fun C P => markProfile T C = P) Ls Ps) (hm : mergeAll markCmp 64 Ps = P) :
    MarkOK n g Q T P := by
  apply BGP212.V2e.markOK_of_chunks <;> assumption

theorem markOK_step {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (q T : ℕ) (P P' : List (MarkKey × K))
    (h : MarkOK n g Q (T + 1) P) (hs : markStep n (stepFactor g q) T P = P') :
    MarkOK n g (Q ++ [q]) T P' := by
  apply BGP212.V2e.markOK_step <;> assumption

theorem markOK_step_chunks {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (q T : ℕ) (P : List (MarkKey × K))
    (Cs Ds : List (List (MarkKey × K))) (P' : List (MarkKey × K))
    (h : MarkOK n g Q (T + 1) P) (hP : Cs.flatten = P)
    (hc : List.Forall₂ (fun C D => markStep n (stepFactor g q) T C = D) Cs Ds)
    (hm : mergeAll markCmp 64 Ds = P') : MarkOK n g (Q ++ [q]) T P' := by
  apply BGP212.V2e.markOK_step_chunks <;> assumption

theorem markOK_mono {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (T T' : ℕ) (hT : T' ≤ T) (P : List (MarkKey × K))
    (h : MarkOK n g Q T P) : MarkOK n g Q T' (P.filter fun e => decide (e.1.2.2.length ≤ T')) := by
  apply BGP212.V2e.markOK_mono <;> assumption

theorem profCert_of_markOK {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (P : List (MarkKey × K))
    (h : MarkOK n g Q 0 P) : ProfCert n g Q (markToProf P) := by
  apply BGP212.V2e.profCert_of_markOK <;> assumption

theorem profCert_of_markStep {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (q : ℕ) (P P' : List (MarkKey × K))
    (R : List ((ℕ × ℕ) × K)) (h : MarkOK n g Q 1 P) (hs : markStep n (stepFactor g q) 0 P = P')
    (hR : markToProf P' = R) : ProfCert n g (Q ++ [q]) R := by
  apply BGP212.V2e.profCert_of_markStep <;> assumption

theorem markOK_of_trie {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (Tr : List (List ℕ × List (SKey × K))) (hT : TrieOK n g Tr)
    (Q : List ℕ) (L : List (SKey × K)) (hp : (Q, L) ∈ Tr) (T : ℕ) :
    MarkOK n g Q T (markProfile T L) := by
  apply BGP212.V2e.markOK_of_trie <;> assumption

theorem markOK_of_tree {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (T : ℕ) (L : List (SKey × K))
    (Ls : List (List (SKey × K))) (Qs : List (List (MarkKey × K))) (Gs : List (List (List (MarkKey × K))))
    (Rs : List (List (MarkKey × K))) (P : List (MarkKey × K))
    (h : ChainCert n (psFactors g Q) [([], 1)] L) (hL : Ls.flatten = L)
    (hc : List.Forall₂ (fun C Qc => markProfile T C = Qc) Ls Qs) (hQ : Gs.flatten = Qs)
    (hg : List.Forall₂ (fun G R => mergeAll markCmp 64 G = R) Gs Rs) (hm : mergeAll markCmp 64 Rs = P) :
    MarkOK n g Q T P := by
  apply BGP212.V2e.markOK_of_tree <;> assumption

theorem markOK_step_tree {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (q T T' : ℕ) (hT : T + 1 ≤ T')
    (P : List (MarkKey × K)) (Cs Ds : List (List (MarkKey × K))) (Gs : List (List (List (MarkKey × K))))
    (Rs : List (List (MarkKey × K))) (P' : List (MarkKey × K))
    (h : MarkOK n g Q T' P) (hP : Cs.flatten = P)
    (hc : List.Forall₂ (fun C D => markStep n (stepFactor g q) T
      (C.filter fun e => decide (e.1.2.2.length ≤ T + 1)) = D) Cs Ds)
    (hD : Gs.flatten = Ds) (hg : List.Forall₂ (fun G R => mergeAll markCmp 64 G = R) Gs Rs)
    (hm : mergeAll markCmp 64 Rs = P') : MarkOK n g (Q ++ [q]) T P' := by
  apply BGP212.V2e.markOK_step_tree <;> assumption

theorem markOK_congr {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (T : ℕ) (P P' : List (MarkKey × K))
    (h : MarkOK n g Q T P)
    (hv : ∀ F : MarkKey → K, (P.map fun e => e.2 * F e.1).sum = (P'.map fun e => e.2 * F e.1).sum) :
    MarkOK n g Q T P' := by
  apply BGP212.V2e.markOK_congr <;> assumption

theorem profOK_append {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (R R' : List (List ℕ × List ((ℕ × ℕ) × K)))
    (h : ProfOK n g R) (h' : ProfOK n g R') : ProfOK n g (R ++ R') := by
  apply BGP212.V2e.profOK_append <;> assumption

theorem profile_insufficient :
    ¬ ∃ f : List ((ℕ × ℕ) × ℚ) → List ((ℕ × ℕ) × ℚ), ∀ (L : List (SKey × ℚ)) (M : ℕ → ℕ → ℚ),
      symFinal M (symStepAll (clsCount 44 6 3) (stepFactor g 2) L) =
        ((f (abProfile L)).map fun e => e.2 * M e.1.1 e.1.2).sum := by
  apply BGP212.V2e.profile_insufficient <;> assumption

theorem classProfile_insufficient :
    ¬ ∃ f : List ((ℕ × ℕ) × ℚ) → List ((ℕ × ℕ × ℕ) × ℚ) → List ((ℕ × ℕ) × ℚ),
      ∀ (L : List (SKey × ℚ)) (M : ℕ → ℕ → ℚ),
        symFinal M (symStepAll (clsCount 44 6 3) (stepFactor g 2) L) =
          ((f (abProfile L) (classProfile L)).map fun e => e.2 * M e.1.1 e.1.2).sum := by
  apply BGP212.V2e.classProfile_insufficient <;> assumption

