namespace BGP212.V2e

open BGP212.Params

/-- **Definition (certified profiles).** The moment profiles of `P̂₂^k`, `k ≤ 6`, reusable by every
inner-term pair, every power of `U` and of `L − S`. -/
def T3_P : List (List ℕ × List ((ℕ × ℕ) × ℚ)) :=
  [([], T3_P0), ([2], T3_P1), ([2, 2], T3_P2), ([2, 2, 2], T3_P3), ([2, 2, 2, 2], T3_P4), ([2, 2, 2, 2, 2], T3_P5), ([2, 2, 2, 2, 2, 2], T3_P6)]

theorem T3_P_cert : ∀ p ∈ T3_P, ProfCert (clsCount 44 6 3) g p.1 p.2 := by
  intro p hp
  simp only [T3_P, List.mem_cons, List.mem_nil_iff, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact T3_pc0
  · exact T3_pc1
  · exact T3_pc2
  · exact T3_pc3
  · exact T3_pc4
  · exact T3_pc5
  · exact T3_pc6

end BGP212.V2e
