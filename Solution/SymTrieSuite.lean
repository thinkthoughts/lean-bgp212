theorem trieOK_root {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) : TrieOK n g [([], [([], 1)])] := by
  apply BGP212.V2e.trieOK_root <;> assumption

theorem trieOK_cons {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (T : List (List ℕ × List (SKey × K))) (Q : List ℕ)
    (L : List (SKey × K)) (q : ℕ) (L' : List (SKey × K)) (hT : TrieOK n g T) (hp : (Q, L) ∈ T)
    (hs : StepCert n (stepFactor g q) L L') : TrieOK n g ((Q ++ [q], L') :: T) := by
  apply BGP212.V2e.trieOK_cons <;> assumption

theorem trieOK_cons_chain {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (T : List (List ℕ × List (SKey × K)))
    (Q : List ℕ) (L : List (SKey × K)) (h : ChainCert n (psFactors g Q) [([], 1)] L)
    (hT : TrieOK n g T) : TrieOK n g ((Q, L) :: T) := by
  apply BGP212.V2e.trieOK_cons_chain <;> assumption

theorem trieOK_placeVal {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (T : List (List ℕ × List (SKey × K)))
    (hT : TrieOK n g T) (Q : List ℕ) (L : List (SKey × K)) (hp : (Q, L) ∈ T) (Q' : List ℕ)
    (hQ : Q'.Perm Q) (M : ℕ → ℕ → K) :
    placeVal M n 0 Fin.elim0 Fin.elim0 (psFactors g Q') = symFinal M L := by
  apply BGP212.V2e.trieOK_placeVal <;> assumption

theorem profOK_nil {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) : ProfOK n g [] := by
  apply BGP212.V2e.profOK_nil <;> assumption

theorem profOK_cons {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (R : List (List ℕ × List ((ℕ × ℕ) × K))) (Q : List ℕ)
    (P : List ((ℕ × ℕ) × K)) (h : ProfCert n g Q P) (hR : ProfOK n g R) : ProfOK n g ((Q, P) :: R) := by
  apply BGP212.V2e.profOK_cons <;> assumption

theorem profCert_perm {K : Type*} [Field K] (n : Fin 3 → ℕ) (g : K) (Q Q' : List ℕ) (P : List ((ℕ × ℕ) × K))
    (h : ProfCert n g Q P) (hQ : Q'.Perm Q) : ProfCert n g Q' P := by
  apply BGP212.V2e.profCert_perm <;> assumption

theorem profCert_of_trie {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (T : List (List ℕ × List (SKey × K)))
    (hT : TrieOK n g T) (Q : List ℕ) (L : List (SKey × K)) (hp : (Q, L) ∈ T)
    (P : List ((ℕ × ℕ) × K)) (hP : abProfile L = P) : ProfCert n g Q P := by
  apply BGP212.V2e.profCert_of_trie <;> assumption

theorem profCert_of_step {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (L : List (SKey × K)) (q : ℕ)
    (P : List ((ℕ × ℕ) × K)) (h : ChainCert n (psFactors g Q) [([], 1)] L)
    (hP : abProfile (symStepAll n (stepFactor g q) L) = P) : ProfCert n g (Q ++ [q]) P := by
  apply BGP212.V2e.profCert_of_step <;> assumption

theorem profCert_of_step_chunks {K : Type*} [Field K] [LinearOrder K] (n : Fin 3 → ℕ) (g : K) (Q : List ℕ) (Cs : List (List (SKey × K)))
    (q : ℕ) (Ps : List (List ((ℕ × ℕ) × K))) (P : List ((ℕ × ℕ) × K))
    (h : ChainCert n (psFactors g Q) [([], 1)] Cs.flatten)
    (hP : List.Forall₂ (fun C P => abProfile (symStepAll n (stepFactor g q) C) = P) Cs Ps)
    (hm : mergeAll abCmp 64 Ps = P) : ProfCert n g (Q ++ [q]) P := by
  apply BGP212.V2e.profCert_of_step_chunks <;> assumption

theorem trieProf_table_eq {K : Type*} [Field K] [LinearOrder K] (N r k : ℕ) (g : K)
    (R : List (List ℕ × List ((ℕ × ℕ) × K))) (hR : ProfOK (clsCount N r k) g R)
    (ws : List (WPair K)) (Mo : ℕ → ℕ → ℕ → ℕ → K) :
    (ws.map fun w => w.1 * genPieceWith N r k g Mo w.2.1 w.2.2.1 w.2.2.2.1 w.2.2.2.2).sum =
      tableVal (profTable N r k g R ws) Mo := by
  apply BGP212.V2e.trieProf_table_eq <;> assumption

theorem trieProf_table_parts {K : Type*} [Field K] [LinearOrder K] (N r k : ℕ) (g : K)
    (R : List (List ℕ × List ((ℕ × ℕ) × K))) (hR : ProfOK (clsCount N r k) g R)
    (wss : List (List (WPair K))) (ws : List (WPair K)) (hw : wss.flatten = ws)
    (Ts : List (List (MKey × K)))
    (h : List.Forall₂ (fun ws T => profTable N r k g R ws = T) wss Ts)
    (T : List (MKey × K)) (hm : mergeAll mkeyCmp 64 Ts = T) (Mo : ℕ → ℕ → ℕ → ℕ → K) :
    (ws.map fun w => w.1 * genPieceWith N r k g Mo w.2.1 w.2.2.1 w.2.2.2.1 w.2.2.2.2).sum =
      tableVal T Mo := by
  apply BGP212.V2e.trieProf_table_parts <;> assumption

theorem table_parts_merge {K : Type*} [Field K] [LinearOrder K] (N r k : ℕ) (g : K)
    (Mo : ℕ → ℕ → ℕ → ℕ → K) (wss : List (List (WPair K))) (ws : List (WPair K))
    (hw : wss.flatten = ws) (Ts : List (List (MKey × K)))
    (h : List.Forall₂ (fun ws T => (ws.map fun w => w.1 * genPieceWith N r k g Mo w.2.1 w.2.2.1
      w.2.2.2.1 w.2.2.2.2).sum = tableVal T Mo) wss Ts)
    (T : List (MKey × K)) (hm : mergeAll mkeyCmp 64 Ts = T) :
    (ws.map fun w => w.1 * genPieceWith N r k g Mo w.2.1 w.2.2.1 w.2.2.2.1 w.2.2.2.2).sum =
      tableVal T Mo := by
  apply BGP212.V2e.table_parts_merge <;> assumption

