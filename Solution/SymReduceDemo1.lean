import Solution.SymReduce

/-! # V2k: small certified examples of the symmetric-function evaluator

COMPUTATIONAL DEMONSTRATION (generated by `specs/checks/sym_reduce_v2k_demo.py`), on the example
data `demoN = (3, 2, 4)`, `demoM`, `demoF` of `BGP212/SymReduce.lean`:

* transition tables `psTrans` (`p_α = Σ_ν R_{α,ν} m̃_ν`, states as canonical lists of parts);
* degrees 4 and 6: V2i's placement value and V2k's value, each evaluated by the kernel, agree;
* degree 8: V2k's value by the kernel; V2i's statement through `symPlaceVal_eq`
  (degree 10 in `Solution/SymReduceDemo3.lean`, a separate `lean` process). -/

namespace BGP212.V2e


/-- **Transition.** `p₂² = m̃_(4) + m̃_(2,2)` in one class. -/
theorem trans_p2_p2 : psTrans (K := ℚ) demoN [(0, 2), (0, 2)] =
    ([([(0, 4)], 1), ([(0, 2), (0, 2)], 1)] : List (SKey × ℚ)) := by
  decide +kernel

/-- **Transition.** `p₁³ = m̃_(3) + 3 m̃_(2,1) + m̃_(1,1,1)` in one class. -/
theorem trans_p1_cubed : psTrans (K := ℚ) demoN [(0, 1), (0, 1), (0, 1)] =
    ([([(0, 3)], 1), ([(0, 2), (0, 1)], 3), ([(0, 1), (0, 1), (0, 1)], 1)] : List (SKey × ℚ)) := by
  decide +kernel

/-- **Transition.** `p_{0,2} p_{1,1} p_{0,1}` across two classes. -/
theorem trans_mixed : psTrans (K := ℚ) demoN [(0, 2), (1, 1), (0, 1)] =
    ([([(0, 3), (1, 1)], 1), ([(0, 2), (0, 1), (1, 1)], 1)] : List (SKey × ℚ)) := by
  decide +kernel

/-- V2i's placement recursion, evaluated by the kernel (degree 4). -/
theorem demo_place_22 : placeVal demoM demoN 0 Fin.elim0 Fin.elim0 (demoF [2, 2]) =
    (1381615373 / 22822800 : ℚ) := by
  decide +kernel

/-- V2k's evaluator, evaluated by the kernel: the same value. -/
theorem demo_sym_22 : symPlaceVal demoM demoN (demoF [2, 2]) = (1381615373 / 22822800 : ℚ) := by
  decide +kernel

/-- V2i's placement recursion, evaluated by the kernel (degree 6). -/
theorem demo_place_222 : placeVal demoM demoN 0 Fin.elim0 Fin.elim0 (demoF [2, 2, 2]) =
    (21901244073952449 / 11626695080000 : ℚ) := by
  decide +kernel

/-- V2k's evaluator, evaluated by the kernel: the same value. -/
theorem demo_sym_222 : symPlaceVal demoM demoN (demoF [2, 2, 2]) = (21901244073952449 / 11626695080000 : ℚ) := by
  decide +kernel

/-- V2k's evaluator by the kernel (degree 8, 4 factors). -/
theorem demo_sym_2222 : symPlaceVal demoM demoN (demoF [2, 2, 2, 2]) = (319427165402625415923 / 3622000086880000 : ℚ) := by
  decide +kernel

/-- V2i's placement value, through `symPlaceVal_eq`. -/
theorem demo_place_2222 : placeVal demoM demoN 0 Fin.elim0 Fin.elim0 (demoF [2, 2, 2, 2]) =
    (319427165402625415923 / 3622000086880000 : ℚ) :=
  (symPlaceVal_eq demoM demoN _).symm.trans demo_sym_2222

end BGP212.V2e
