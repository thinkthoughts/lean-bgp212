import Solution.SymTrieKept

/-! # V2m: counts and trie shapes of the enumerated multisets

COMPUTATIONAL DEMONSTRATION (generated by `specs/checks/sym_trie_v2m_demo.py`). Tables are coefficient representations;
the rational moments `pieceMn` are evaluated separately. -/

namespace BGP212.V2e

open BGP212.Params


/-- The `B₂₁` partitions and kept-part lists: 139 each. -/
theorem b21_counts : b21Lambdas.length = 139 ∧ b21Kept.length = 139 :=
  ⟨by decide +kernel, by rw [b21Kept_eq]; decide +kernel⟩

/-- The block `|λ| ≤ 6`: 22 factor multisets, sorted and prefix-closed. -/
theorem block6_shape : (blockMultisets 6).length = 22 ∧ trieShapeOK (blockMultisets 6) = true := by
  decide +kernel

/-- The multisets of `B₂₁` with at most two factors: 66, sorted and prefix-closed. -/
theorem short2_shape : (shortMultisets 2).length = 66 ∧ trieShapeOK (shortMultisets 2) = true := by
  rw [shortMultisets, b21Kept_eq]; decide +kernel

end BGP212.V2e
