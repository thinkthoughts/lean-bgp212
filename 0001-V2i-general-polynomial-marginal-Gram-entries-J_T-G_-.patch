+  have hz : ∑ x ∈ Finset.range 29, (((44 - 10).choose (6 + x) : ℕ) : ℚ) *
+      (-1) ^ (6 + x) * genPiece 44 10 (6 + x) g L τ C 1 [] 0 [] = 0 :=
+    Finset.sum_eq_zero fun x _ => by
+      rw [genPiece_empty 44 10 (6 + x) g L τ C (cond_tail 10 (6 + x) (by omega)), mul_zero]
+  rw [genRow, show 44 - 10 + 1 = 6 + 29 from rfl, Finset.sum_range_add, hz, add_zero]
+  simp only [Finset.sum_range_succ, Finset.sum_range_zero, gpLP_10_0, gpLP_10_1, gpLP_10_2, gpLP_10_3, gpLP_10_4, gpLP_10_5]
+  decide +kernel
