+#!/usr/bin/env python3
+"""Emit the kernel certificate for V2i's worked entries at Table 3.
+
+Entries (`genEntryVal 44 g L τ C a₁ l₁ a₂ l₂`, BGP212/GenEntry.lean):
+  PP  = J_T[P₂, P₂]        (0, [2], 0, [2])  cross-check against V2h's p2p2EntryVal
+  P4  = J_T[P₄, 1]         (0, [4], 0, [])
+  P22 = J_T[P_{(2,2)}, 1]  (0, [2, 2], 0, [])
+  LP  = J_T[L − P₁, 1]     (1, [], 0, [])
+
+Moment table per piece (moments are certified once and shared by all entries):
+  (A, B, 2, 0)  V2h's `mom_r_k_A_B` (pieceM … 2) through `pieceMn_zero`;
+  (eR, eS, 4, 0) V2h's `e4_r_k_eR_eS` (pieceE … 4) through `pieceMn_of_pieceE`;
+  (0, 0, 6, 0)  V2h's `u6_r_k` (pieceJ … 6 0) through `pieceMn_zero_zero`;
+  (0, 0, 2, 1), (0, 0, 3, 0)  new, `mn_r_k_…` by `decide +kernel`.
+Each piece value `genPiece 44 r k …` is then `genPieceWith` against `tableFn` of these numerals
+(`tableFn_eq`), evaluated by `decide +kernel` (only coefficients and placements, no cells).
+
+Files: Solution/GenEntryCert0.lean … GenEntryCert13.lean (one per row, each importing V2h's row
+file), Solution/GenEntryCertSum.lean (rows and totals).
+
+Usage: python3 -I specs/checks/gen_entry_v2i_emit.py [outdir] [--test r:k,... FILE]
+"""
+import os
+import sys
+from fractions import Fraction as Fr
+from math import comb, factorial as fact
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import marginal_entry_v2f_emit as E  # noqa: E402
+import power_sum_entry_v2g_emit as P  # noqa: E402
+import gen_entry_v2i_model as Q  # noqa: E402
+
+PIECES = [(r, k) for r in range(14) for k in range(16 - r)]
+ENTRIES = [("PP", (0, [2], 0, [2])), ("P4", (0, [4], 0, [])), ("P22", (0, [2, 2], 0, [])),
+           ("LP", (1, [], 0, []))]
+NEW = [(0, 0, 2, 1), (0, 0, 3, 0)]
+
+
+def lit(x):
+    x = Fr(x)
+    return f"({x.numerator} : ℚ)" if x.denominator == 1 else f"({x.numerator} / {x.denominator} : ℚ)"
+
+
+def lean_list(l):
+    return "[" + ", ".join(str(q) for q in l) + "]"
+
+
+def key_entry(r, k, key, val):
+    """(Lean value expression, proof term) of one table entry."""
+    A, B, m, n = key
+    if (m, n) == (2, 0):
+        return lit(val), f"(pieceMn_zero 44 {r} {k} {A} {B} g L τ C 2).trans mom_{r}_{k}_{A}_{B}"
+    if (m, n) == (4, 0):
+        e4 = P.pieceE(r, k, A, B, 4)
+        d = (1 if r == 0 else fact(A)) * fact(B)
+        assert e4 / d == val, (r, k, key)
+        expr = (f"{lit(e4)} / (((if {r} = 0 then 1 else Nat.factorial {A}) * Nat.factorial {B} : ℕ) : ℚ)")
+        return expr, f"pieceMn_of_pieceE 44 {r} {k} {A} {B} g L τ C 4 _ e4_{r}_{k}_{A}_{B}"
+    if key == (0, 0, 6, 0):
+        return lit(val), f"(pieceMn_zero_zero 44 {r} {k} g L τ C 6 0).trans u6_{r}_{k}"
+    if key in NEW:
+        return lit(val), f"mn_{r}_{k}_{A}_{B}_{m}_{n}"
+    raise KeyError(key)
+
+
+def piece_lemmas(r, k, vals, out):
+    for key in NEW:
+        A, B, m, n = key
+        out.append(f"theorem mn_{r}_{k}_{A}_{B}_{m}_{n} : pieceMn 44 {r} {k} {A} {B} g L τ C {m} {n} = "
+                   f"{lit(vals[key])} := by\n  decide +kernel\n")
+    for name, args in ENTRIES:
+        ks = Q.keys(*args)
+        ents = [key_entry(r, k, kk, vals[kk]) for kk in ks]
+        table = "[" + ", ".join(f"(({kk[0]}, {kk[1]}, {kk[2]}, {kk[3]}), {e[0]})" for kk, e in zip(ks, ents)) + "]"
+        proof = "fun _ h => absurd h List.not_mem_nil"
+        for e in reversed(ents):
+            proof = f"List.forall_mem_cons.2 ⟨{e[1]}, {proof}⟩"
+        v = Q.genPiece(r, k, *args, Mo=lambda A, B, m, n: vals[(A, B, m, n)])
+        a1, l1, a2, l2 = args
+        out.append(
+            f"theorem gp{name}_{r}_{k} : genPiece 44 {r} {k} g L τ C {a1} {lean_list(l1)} {a2} {lean_list(l2)} = "
+            f"{lit(v)} := by\n"
+            f"  rw [genPiece, ← tableFn_eq {table}\n"
+            f"    (fun A B m n => pieceMn 44 {r} {k} A B g L τ C m n)\n"
+            f"    ({proof})]\n"
+            "  decide +kernel\n")
+
+
+HDR = """/-
+Copyright (c) 2026 thinkthoughts. All rights reserved.
+Released under MIT license as described in the file LICENSE.
+Source: Axiom Math, "A New Bound for Small Gaps Between Primes", preliminary draft
+(September 3, 2026): Table 3 (p. 39), §9.4, Lemma 9.2 and the display of `J_T` (p. 41).
+-/
+"""
+
+
+def all_values():
+    keys = sorted({kk for _, args in ENTRIES for kk in Q.keys(*args)})
+    return {rk: {kk: Q.pieceMn(*rk, *kk) for kk in keys} for rk in PIECES}
+
+
+def row_file(r, cache):
+    out = [HDR, "import Solution.GenEntryTable\n", f"import Solution.PowerSumSquareCert{r}\n",
+           f"/-! # V2i: the kernel certificate for the worked `J_T` entries at Table 3, row `r = {r}`\n\n"
+           "COMPUTATIONAL CERTIFICATE (generated by `specs/checks/gen_entry_v2i_emit.py`). For each nonempty\n"
+           "piece `(r, k)`: the new moments `pieceMn … 2 1` and `pieceMn … 3 0` (`mn_r_k_…`), and the piece\n"
+           "values `genPiece` of the entries `PP`, `P4`, `P22`, `LP` against a table of certified moments\n"
+           "(V2h's for the powers `U²`, `U⁴`, `U⁶`), each by `decide +kernel`. -/\n",
+           "namespace BGP212.V2e\n", "open BGP212.Params\n"]
+    for (rr, k) in PIECES:
+        if rr == r:
+            piece_lemmas(r, k, cache[(r, k)], out)
+    out.append("end BGP212.V2e\n")
+    return "\n".join(out)
+
+
+def sum_file(cache):
+    out = [HDR, "import Solution.PowerSumEntryCert\nimport Solution.PowerSumSquareCertSum\n" +
+           "".join(f"import Solution.GenEntryCert{r}\n" for r in range(14)),
+           "/-! # V2i: the kernel certificate for the worked `J_T` entries at Table 3 (rows and totals)\n\n"
+           "COMPUTATIONAL CERTIFICATE (generated by `specs/checks/gen_entry_v2i_emit.py`). Pieces with\n"
+           "`r + k ≥ 16` or `r ≥ 14` are empty at Table 3 (V2g's `cond_tail`, `cond_high`; `genPiece_empty`);\n"
+           "rows and totals are assembled by `decide +kernel` on numerals. -/\n",
+           "namespace BGP212.V2e\n", "open BGP212.Params\n"]
+    totals = {}
+    for name, args in ENTRIES:
+        a1, l1, a2, l2 = args
+        A = f"{a1} {lean_list(l1)} {a2} {lean_list(l2)}"
+        out.append(f"theorem genRow{name}_high (r : ℕ) (h : 14 ≤ r) : genRow 44 r g L τ C {A} = 0 :=\n"
+                   f"  Finset.sum_eq_zero fun k _ => by rw [genPiece_empty 44 r k g L τ C (cond_high r k h), mul_zero]\n")
+        rows = {}
+        for r in range(14):
+            K = 16 - r
+            tail = (44 - r + 1) - K
+            vals = {k: Q.genPiece(r, k, *args, Mo=lambda A_, B_, m, n, r=r, k=k: cache[(r, k)][(A_, B_, m, n)])
+                    for k in range(K)}
+            rows[r] = sum(comb(44 - r, k) * (-1) ** k * vals[k] for k in range(K))
+            names = ", ".join(f"gp{name}_{r}_{k}" for k in range(K))
+            out.append(
+                f"theorem genRow{name}_{r} : genRow 44 {r} g L τ C {A} = {lit(rows[r])} := by\n"
+                f"  have hz : ∑ x ∈ Finset.range {tail}, (((44 - {r}).choose ({K} + x) : ℕ) : ℚ) *\n"
+                f"      (-1) ^ ({K} + x) * genPiece 44 {r} ({K} + x) g L τ C {A} = 0 :=\n"
+                f"    Finset.sum_eq_zero fun x _ => by\n"
+                f"      rw [genPiece_empty 44 {r} ({K} + x) g L τ C (cond_tail {r} ({K} + x) (by omega)), mul_zero]\n"
+                f"  rw [genRow, show 44 - {r} + 1 = {K} + {tail} from rfl, Finset.sum_range_add, hz, add_zero]\n"
+                f"  simp only [Finset.sum_range_succ, Finset.sum_range_zero, {names}]\n"
+                "  decide +kernel\n")
+        tot = 45 * sum(comb(44, r) * rows[r] for r in range(14))
+        totals[name] = tot
+        out.append(
+            f"theorem genEntry{name}_table3 : genEntryVal 44 g L τ C {A} = {lit(tot)} := by\n"
+            f"  have hz : ∑ x ∈ Finset.range 31, ((Nat.choose 44 (14 + x) : ℕ) : ℚ) *\n"
+            f"      genRow 44 (14 + x) g L τ C {A} = 0 :=\n"
+            f"    Finset.sum_eq_zero fun x _ => by rw [genRow{name}_high (14 + x) (by omega), mul_zero]\n"
+            f"  rw [genEntryVal, show 44 + 1 = 14 + 31 from rfl, Finset.sum_range_add, hz, add_zero]\n"
+            "  simp only [Finset.sum_range_succ, Finset.sum_range_zero, "
+            + ", ".join(f"genRow{name}_{r}" for r in range(14)) + "]\n"
+            "  decide +kernel\n")
+    out.append("/-- The general closed form reproduces V2h's certified `J_T[P₂, P₂]`. -/\n"
+               "theorem genEntryPP_eq_v2h : genEntryVal 44 g L τ C 0 [2] 0 [2] = p2p2EntryVal 44 g L τ C := by\n"
+               "  rw [genEntryPP_table3, p2p2EntryVal_table3]\n")
+    out.append("end BGP212.V2e\n")
+    return "\n".join(out), totals
+
+
+if __name__ == "__main__":
+    if "--test" in sys.argv:
+        i = sys.argv.index("--test")
+        ps = [tuple(int(v) for v in x.split(":")) for x in sys.argv[i + 1].split(",")]
+        keys = sorted({kk for _, args in ENTRIES for kk in Q.keys(*args)})
+        out = [HDR, "import Solution.GenEntryTable\n"] + [f"import Solution.PowerSumSquareCert{r}\n"
+                                                        for r in sorted({r for r, _ in ps})]
+        out += ["namespace BGP212.V2e\n", "open BGP212.Params\n"]
+        for (r, k) in ps:
+            piece_lemmas(r, k, {kk: Q.pieceMn(r, k, *kk) for kk in keys}, out)
+        out.append("end BGP212.V2e\n")
+        open(sys.argv[i + 2], "w").write("\n".join(out))
+        sys.exit(0)
+    outdir = sys.argv[1] if len(sys.argv) > 1 else "Solution"
+    cache = all_values()
+    for r in range(14):
+        open(os.path.join(outdir, f"GenEntryCert{r}.lean"), "w").write(row_file(r, cache))
+    text, totals = sum_file(cache)
+    open(os.path.join(outdir, "GenEntryCertSum.lean"), "w").write(text)
+    for name, v in totals.items():
+        print(name, float(v), v.numerator, "/", v.denominator)
