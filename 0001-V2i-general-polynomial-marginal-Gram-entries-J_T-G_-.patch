+theorem tableFn_eq {K : Type*} [Field K] [LinearOrder K] (keys : List ((ℕ × ℕ × ℕ × ℕ) × K)) (dflt : ℕ → ℕ → ℕ → ℕ → K)
+    (h : ∀ p ∈ keys, dflt p.1.1 p.1.2.1 p.1.2.2.1 p.1.2.2.2 = p.2) : tableFn keys dflt = dflt := by
