+#!/usr/bin/env python3
+"""Emit V2j's kernel demonstration (Solution/MomentAggDemo1.lean … MomentAggDemo4.lean; evaluations
+and assemblies in separate files so that each `lean` process stays within memory).
+
+The certificate is staged so that every kernel evaluation is a separate declaration:
+  * `nd_*`, `cov_*`: the key list S is duplicate-free and contains every queried key
+    (`decide`; these are the hypotheses of `aggPieceOn_eq`);
+  * `ck_*`: the collapsed coefficient `aggCoeff … s` of each key (no moment is evaluated);
+  * `mo_*`: each distinct moment `pieceMn … s`, evaluated once, directly from V2f's cells;
+  * `agg_*`: the aggregated sum `aggPieceOn S …` assembled from those numerals (`norm_num`);
+  * the link to V2i through `aggPieceOn_eq`.
+
+Demonstrations:
+  * piece (r, k) = (6, 3) at Table 3, J_T[P₂, P₂]: 19 moments; the resulting statement is V2i's
+    certified `gpPP_6_3` (checked by `rfl` on the proofs, i.e. identical statements), recomputed
+    independently of V2h's moment lemmas;
+  * the same piece for V2i's four entries together (PP, P4, P22, LP): 21 shared keys, 2 new
+    moments, equal to the sum of the four V2i piece values;
+  * synthetic N = 3: every piece of J_T[P₂, P₂], then the whole entry `aggEntryValOn`, equal to V2h's
+    synthetic value, and V2i's `genEntryVal` through `aggEntryValOn_eq`.
+
+Usage: python3 -I specs/checks/moment_agg_v2j_demo.py [outdir]
+"""
+import os
+import re
+import sys
+from fractions import Fraction as Fr
+from math import comb
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import gen_entry_v2i_model as Q  # noqa: E402
+
+ENTRIES = [("PP", (0, [2], 0, [2])), ("P4", (0, [4], 0, [])), ("P22", (0, [2, 2], 0, [])),
+           ("LP", (1, [], 0, []))]
+
+
+def lit(x):
+    x = Fr(x)
+    return f"({x.numerator} : ℚ)" if x.denominator == 1 else f"({x.numerator} / {x.denominator} : ℚ)"
+
+
+def ll(l):
+    return "[" + ", ".join(map(str, l)) + "]"
+
+
+def wl(entries):
+    return "[" + ", ".join(f"((1 : ℚ), {a1}, {ll(l1)}, {a2}, {ll(l2)})" for _, (a1, l1, a2, l2) in entries) + "]"
+
+
+def klist(ks):
+    return "[" + ", ".join(f"({a}, {b}, {m}, {n})" for (a, b, m, n) in ks) + "]"
+
+
+def coeff(r, k, entries, s):
+    return sum(Q.genPiece(r, k, *args, Mo=lambda A, B, m, n: Fr(1) if (A, B, m, n) == s else Fr(0))
+               for _, args in entries)
+
+
+def keyset(entries):
+    ks = set()
+    for _, args in entries:
+        ks |= set(Q.keys(*args))
+    return sorted(ks)
+
+
+def piece_block(tag, r, k, entries, N, gL, dataL, mo_names, out, asm_out=None):
+    """Emit coefficient lemmas, missing moment lemmas, and the assembly for one piece."""
+    ks = keyset(entries)
+    S = klist(ks)
+    ws = wl(entries)
+    out.append(f"theorem nd_{tag} : ({S} : List MKey).Nodup := by decide\n")
+    out.append(f"theorem cov_{tag} : ∀ w ∈ ({ws} : List (WPair ℚ)), ∀ s ∈ genKeys {gL} w.2.1 w.2.2.1 "
+               f"w.2.2.2.1 w.2.2.2.2, s ∈ ({S} : List MKey) := by\n  decide +kernel\n")
+    names = []
+    total = Fr(0)
+    for i, s in enumerate(ks):
+        c = coeff(r, k, entries, s)
+        out.append(f"theorem ck_{tag}_{i} : aggCoeff {N} {r} {k} {gL} {ws} {s} = {lit(c)} := by\n  decide +kernel\n")
+        names.append(f"ck_{tag}_{i}")
+        key = (N, r, k, s)
+        if key not in mo_names:
+            v = Q.pieceMn(r, k, *s)
+            nm = f"mo_{N}_{r}_{k}_{s[0]}_{s[1]}_{s[2]}_{s[3]}"
+            out.append(f"theorem {nm} : pieceMn {N} {r} {k} {s[0]} {s[1]} {gL} {dataL} {s[2]} {s[3]} = "
+                       f"{lit(v)} := by\n  decide +kernel\n")
+            mo_names[key] = (nm, v)
+        names.append(mo_names[key][0])
+        total += c * mo_names[key][1]
+    asm = (f"theorem agg_{tag} : aggPieceOn {S} {N} {r} {k} {gL} {ws}\n"
+               f"    (fun A B m n => pieceMn {N} {r} {k} A B {gL} {dataL} m n) = {lit(total)} := by\n"
+               f"  simp only [aggPieceOn, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,\n"
+               f"    {', '.join(names)}]\n  norm_num\n")
+    if asm_out is None:
+        out.append(asm)
+    else:
+        asm_out.append(asm)
+    return S, ws, total
+
+
+HDR = """/-
+Copyright (c) 2026 thinkthoughts. All rights reserved.
+Released under MIT license as described in the file LICENSE.
+Source: Axiom Math, "A New Bound for Small Gaps Between Primes", preliminary draft
+(September 3, 2026): Table 3 (p. 39), §9.4, the display of `J_T` (p. 41).
+-/
+import Solution.MomentAgg
+import Solution.GenEntryCert6
+
+/-! # V2j: kernel demonstration of shared-moment aggregation
+
+COMPUTATIONAL DEMONSTRATION (generated by `specs/checks/moment_agg_v2j_demo.py`). Every kernel
+evaluation is its own declaration: key-list hypotheses (`nd_*`, `cov_*`), collapsed coefficients
+(`ck_*`), each distinct moment once (`mo_*`, directly from `pieceMn`), the aggregated sums
+(`agg_*`), then V2j's `aggPieceOn_eq` / `aggEntryValOn_eq` give V2i's values.
+
+* `genPiecePP_6_3_viaAgg` recomputes V2i's certified piece value `gpPP_6_3` (same statement,
+  `genPiecePP_6_3_same_as_v2i`) from 19 moments, without V2h's moment lemmas;
+* `agg4_6_3_eq` evaluates V2i's four entries on that piece from 21 shared keys;
+* `genEntrySmall_PP` is `J_T[P₂, P₂]` on synthetic data `N = 3` (V2h's synthetic value). -/
+
+namespace BGP212.V2e
+
+open BGP212.Params
+
+"""
+
+HDR2 = """/-
+Copyright (c) 2026 thinkthoughts. All rights reserved.
+Released under MIT license as described in the file LICENSE.
+Source: Axiom Math, "A New Bound for Small Gaps Between Primes", preliminary draft
+(September 3, 2026): Table 3 (p. 39), §9.4, the display of `J_T` (p. 41).
+-/
+import {prev}
+
+/-! # V2j: kernel demonstration of shared-moment aggregation (continued)
+
+COMPUTATIONAL DEMONSTRATION (generated by `specs/checks/moment_agg_v2j_demo.py`); see
+`Solution/MomentAggDemo1.lean`. -/
+
+namespace BGP212.V2e
+
+open BGP212.Params
+
+"""
+
+
+def main():
+    out_dir = sys.argv[1] if len(sys.argv) > 1 else "Solution"
+    here = os.path.dirname(os.path.abspath(__file__))
+    cert = open(os.path.join(here, "../../Solution/GenEntryCert6.lean")).read()
+    v2i = {}
+    for name, args in ENTRIES:
+        m = re.search(rf"theorem gp{name}_6_3 : genPiece[^=]*= \((\d+(?: / \d+)?) : ℚ\)", cert)
+        v2i[name] = Fr(m.group(1).replace(" ", ""))
+    out = [HDR]
+    mo = {}
+    files = []
+    nxt = [HDR2.format(prev="Solution.MomentAggDemo1")]
+    S1, ws1, t1 = piece_block("PP_6_3", 6, 3, ENTRIES[:1], 44, "g", "L τ C", mo, out, nxt)
+    assert t1 == v2i["PP"]
+    out.append("end BGP212.V2e\n")
+    files.append(out)
+    out = nxt
+    out.append(f"""theorem genPiecePP_6_3_viaAgg : genPiece 44 6 3 g L τ C 0 [2] 0 [2] = {lit(t1)} :=
+  (genPiece_eq_aggPieceOn {S1} nd_PP_6_3 44 6 3 g L τ C 0 [2] 0 [2] cov_PP_6_3).trans agg_PP_6_3
+
+/-- The recomputation proves exactly V2i's certified statement `gpPP_6_3`. -/
+theorem genPiecePP_6_3_same_as_v2i : genPiecePP_6_3_viaAgg = gpPP_6_3 := rfl
+""")
+    nxt = [HDR2.format(prev="Solution.MomentAggDemo2")]
+    S4, ws4, t4 = piece_block("ALL_6_3", 6, 3, ENTRIES, 44, "g", "L τ C", mo, out, nxt)
+    assert t4 == sum(v2i.values())
+    out.append("end BGP212.V2e\n")
+    files.append(out)
+    out = nxt
+    out.append(f"""/-- The four V2i entries on piece `(6, 3)`: `Σ_{{w ∈ ws}} w · genPieceWith … = …` from 21 shared keys. -/
+theorem agg4_6_3_eq : (List.map (fun w : WPair ℚ => w.1 * genPieceWith 44 6 3 g
+    (fun A B m n => pieceMn 44 6 3 A B g L τ C m n) w.2.1 w.2.2.1 w.2.2.2.1 w.2.2.2.2) {ws4}).sum =
+    {lit(t4)} :=
+  (aggPieceOn_eq {S4} nd_ALL_6_3 44 6 3 g {ws4} cov_ALL_6_3
+    (fun A B m n => pieceMn 44 6 3 A B g L τ C m n)).symm.trans agg_ALL_6_3
+""")
+    out.append("end BGP212.V2e\n")
+    files.append(out)
+    out = [HDR2.format(prev="Solution.MomentAgg")]
+    CS = [Fr(0), Fr(1, 2), Fr(3, 5), Fr(7, 10)]
+    Q.setdata(3, Fr(3, 10), Fr(1), Fr(9, 10), lambda m: CS[min(m, 3)])
+    pieces = [(r, k) for r in range(4) for k in range(4 - r)]
+    vals = {}
+    Ss = wsS = None
+    for (r, k) in pieces:
+        Ss, wsS, v = piece_block(f"S_{r}_{k}", r, k, ENTRIES[:1], 3, "(3 / 10 : ℚ)", "1 (9 / 10) synthC", mo, out)
+        vals[(r, k)] = v
+    small = 4 * sum(comb(3, r) * comb(3 - r, k) * (-1) ** k * vals[(r, k)] for (r, k) in pieces)
+    names = ", ".join(f"agg_S_{r}_{k}" for (r, k) in pieces)
+    out.append(f"""theorem aggSmall_PP : aggEntryValOn {Ss} 3 (3 / 10 : ℚ) 1 (9 / 10) synthC {wsS} = {lit(small)} := by
+  simp only [aggEntryValOn, Finset.sum_range_succ, Finset.sum_range_zero, Nat.reduceSub, Nat.reduceAdd,
+    {names}]
+  norm_num
+
+theorem genEntrySmall_PP : genEntryVal 3 (3 / 10 : ℚ) 1 (9 / 10) synthC 0 [2] 0 [2] = {lit(small)} :=
+  (genEntryVal_eq_aggEntryValOn {Ss} nd_S_0_0 3 (3 / 10 : ℚ) 1 (9 / 10) synthC 0 [2] 0 [2] cov_S_0_0).trans
+    aggSmall_PP
+""")
+    out.append("end BGP212.V2e\n")
+    files.append(out)
+    for i, f in enumerate(files, 1):
+        open(os.path.join(out_dir, f"MomentAggDemo{i}.lean"), "w").write("\n".join(f))
+    print("wrote", out_dir, "| moments evaluated:", len(mo), "| PP piece", float(t1), "| four entries",
+          float(t4), "| synthetic J[P2,P2]", float(small))
+
+
+if __name__ == "__main__":
+    main()
